# ── Required ──────────────────────────────────────────────────────────
BOT_TOKEN=                     # From @BotFather
ADMIN_IDS=                     # Comma-separated numeric Telegram user IDs
STORAGE_CHANNEL_ID=            # Numeric ID of the private storage channel (bot must be admin there)
BOT_USERNAME=                  # Without the @

# ── Optional — core behavior (safe defaults shown) ──────────────────────
BASE_URL=http://127.0.0.1:8000
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=database.db
PROTECT_CONTENT=True
SESSION_MINUTES=10
STRIKE_LIMIT=3

# ── Optional — roles ─────────────────────────────────────────────────────
# If unset, the lowest numeric ID in ADMIN_IDS automatically becomes the
# owner. Set explicitly if you want a different/specific owner.
OWNER_IDS=

# ── Optional — MongoDB backend ───────────────────────────────────────────
# Leave DB_BACKEND=sqlite (or unset) to keep using the existing SQLite
# database.db, unchanged. Only set DB_BACKEND=mongo after running and
# verifying migrate_to_mongo.py --migrate --verify.
DB_BACKEND=sqlite
MONGO_URI=
MONGO_DB_NAME=trissz_bot
